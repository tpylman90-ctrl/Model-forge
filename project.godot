; Model Forge project, pinned to Godot 4.5.2
config_version=5

[application]
config/name="Model Forge"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.5", "Mobile")
config/description="Touch-first GLB editor"

[display]
window/size/viewport_width=1440
window/size/viewport_height=810
window/stretch/mode="canvas_items"
window/handheld/orientation=0

[input_devices]
pointing/emulate_mouse_from_touch=false

[rendering]
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
environment/defaults/default_clear_color=Color(0.07, 0.10, 0.15, 1)
